# --- Clerk auth (web bilan bir xil instance) ---
# Web .env dagi NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY bilan bir xil qiymat.
# Haqiqiy qiymatni `.env.local` ga yozing (u gitignore'da).
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx

# --- Stripe (web bilan bir xil publishable key) ---
# Web .env dagi NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY bilan bir xil.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# --- Backend API (ixtiyoriy) ---
# Production APK / real device (internet orqali):
# EXPO_PUBLIC_API_URL=https://YOUR-APP.vercel.app/en/api/mobile
#
# Dev: odatda shart emas — Expo Metro IP avtomatik ishlatiladi.
# Agar `npm run dev` 3001 da ishlasa (3000 band):
# EXPO_PUBLIC_API_PORT=3001
# Agar avtomatik ishlamasa, kompyuter IP ni qo'lda yozing:
# EXPO_PUBLIC_API_URL=http://10.20.15.165:3000/en/api/mobile
